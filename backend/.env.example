# backend/.env 로 복사해 값을 채웁니다. 이 파일에는 변수 이름만 둡니다(키 금지).

# ─── 모델 (엘리스 ML API, OpenAI 호환) ───
# 엘리스는 모델마다 엔드포인트가 다릅니다. 모델 페이지의 주소 끝에 /v1 을 붙입니다.
#   예: https://mlapi.run/<모델별 엔드포인트 ID>/v1
# ELICE_MODEL 은 그 엔드포인트가 허용하는 모델 이름과 같아야 합니다(다르면 접근 거절).
# 모델 이름에는 접두어가 붙습니다. 예: openai/gpt-5.6-terra, anthropic/claude-sonnet-5
# API 키는 모든 모델이 같으면 ELICE_API_KEY 하나로 충분합니다.
ELICE_API_KEY=
ELICE_BASE_URL=
ELICE_MODEL=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_REASONING_EFFORT=

# ─── 역할별 모델 (선택) ───
# 형식: {역할}_LLM_MODEL / _API_KEY / _BASE_URL / _MAX_TOKENS / _TIMEOUT_SECONDS / _REASONING_EFFORT
# 비운 값은 위 공통 값으로 돌아갑니다. 다른 모델을 쓰면 MODEL 과 BASE_URL 을 함께 바꿉니다.
# JSON mode·토큰 한도·reasoning_effort·tool 호출 지원 여부는 모델마다 연결 시험이 필요합니다.

# 최종 판단(decision)
DECISION_LLM_MODEL=
DECISION_LLM_BASE_URL=
DECISION_LLM_API_KEY=
DECISION_LLM_MAX_TOKENS=
DECISION_LLM_TIMEOUT_SECONDS=
DECISION_LLM_REASONING_EFFORT=

# 평가자 4명
EVALUATOR_LLM_MODEL=
EVALUATOR_LLM_BASE_URL=
EVALUATOR_LLM_API_KEY=
EVALUATOR_LLM_MAX_TOKENS=
EVALUATOR_LLM_TIMEOUT_SECONDS=
EVALUATOR_LLM_REASONING_EFFORT=

# 보조 에이전트 — decision 과 다른 계열 권장. 예: anthropic/claude-sonnet-5
# 애매한 판단에만 자문으로 사용합니다.
ADVISOR_LLM_MODEL=
ADVISOR_LLM_BASE_URL=
ADVISOR_LLM_API_KEY=
ADVISOR_LLM_MAX_TOKENS=
ADVISOR_LLM_TIMEOUT_SECONDS=
ADVISOR_LLM_REASONING_EFFORT=

# ─── 주소 → 좌표 · 지도 ───
# 카카오 REST 키. 지도 조회도 같은 키를 씁니다.
GEOCODING_API_KEY=
MAP_ANALYSIS_MAX_CONCURRENCY=

# ─── 교육환경보호구역 (V-World 2D 데이터 API, LT_C_UO101) ───
# vworld.kr 에서 발급합니다. 공공데이터포털 키와 다릅니다.
VWORLD_API_KEY=
# Referer 헤더로 보냅니다. 없으면 INCORRECT_KEY 로 거절됩니다.
# 비워 두면 http://localhost:8000. 배포 주소가 생기면 발급 때 등록한 URL 로 바꿉니다.
VWORLD_REFERER=

# ─── 건축물대장 (공공데이터포털 건축HUB 건축물대장정보 서비스) ───
# 상가 정보 확인 화면용. 공공데이터포털에서 활용신청 후 받은 일반 인증키를 넣습니다.
# Encoding·Decoding 두 개가 보이면 Decoding 쪽입니다.
BUILDING_REGISTRY_API_KEY=

# ─── 분석 데이터 API ───
# 유동·상주·직장인구(서울 열린데이터광장)
FLOATING_POPULATION_API_KEY=
# 서울 API 기본 주소·서비스명을 바꿀 때만 설정합니다.
# SEOUL_OPEN_API_BASE=
# SEOUL_FLPOP_SERVICE=
# SEOUL_TRDAR_AREA_SERVICE=
# 개폐업(서울 열린데이터광장). 비우면 SEOUL_OPEN_API_KEY 를 씁니다.
BUSINESS_LIFECYCLE_API_KEY=
SEOUL_OPEN_API_KEY=
# 상권 점포(공공데이터포털 소상공인시장진흥공단)
COMMERCIAL_AREA_API_KEY=
FRANCHISE_API_KEY=
# 공공데이터 쿼터(하루 10,000건)와 429 를 고려한 동시 요청 수
SBIZ_MAX_CONCURRENCY=

# ─── 개폐업 추가 설정 ───
# 재현용으로 분기를 고정할 때만 씁니다. 비우면 최신 유효 분기를 자동 탐색합니다.
BUSINESS_LIFECYCLE_BASE_QUARTER=
BUSINESS_LIFECYCLE_QUARTER_COUNT=
BUSINESS_LIFECYCLE_LATEST_QUARTER_SEARCH_COUNT=
BUSINESS_LIFECYCLE_TIMEOUT_SECONDS=
# 저장소에 없는 서울시 상권영역 SHP 경로입니다.
BUSINESS_LIFECYCLE_AREA_SHP_PATH=
# 특정 상권을 강제할 때만 씁니다. 둘 다 비우면 좌표로 자동 판별합니다.
BUSINESS_LIFECYCLE_AREA_CODE=
BUSINESS_LIFECYCLE_AREA_NAME=

# ─── 서버 ───
# 상대 경로는 backend 기준입니다.
# 비워 활성화하지 않고, 경로를 직접 지정할 때만 주석을 풉니다.
# SQLITE_PATH=
# wait=false 백그라운드 동시 분석 수
# ANALYSIS_MAX_CONCURRENCY=
# 프론트엔드 주소. 여러 개면 쉼표로 이어 붙입니다.
# CORS_ALLOW_ORIGINS=
# 1 이면 외부 호출 없이 고정 응답을 돌려줍니다(화면 연동용).
MOCK_MODE=
# 요청 DB와 분리한 서울 분기 자료 DB (미지정: 사용자 홈/.chaeum/market_data.sqlite3)
LOCAL_DATA_DB_PATH=

# ─── 인증 ───
# 카카오 로그인. GEOCODING_API_KEY와 값이 같아도 변수는 분리합니다.
# 같이 쓰면 키를 돌릴 때 주소·지도 조회가 함께 죽습니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 값과 한 글자도 달라선 안 됩니다(다르면 KOE006).
# 로컬: http://localhost:8000/api/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=

# 가입 인증·비밀번호 재설정 메일(Resend). 없으면 메일만 실패하고 가입은 됩니다.
RESEND_API_KEY=
MAIL_FROM=

# 로그인 뒤 돌아갈 프론트 주소. 메일 링크도 이 주소로 만듭니다.
FRONTEND_BASE_URL=http://localhost:3000
# 운영은 true. 로컬 http로 띄울 때만 false.
SESSION_COOKIE_SECURE=true
