# ─── 모델 (엘리스 OpenAI 호환 API) ───
# 모델 이름에는 접두어가 붙습니다. 예: anthropic/claude-sonnet-5
ELICE_API_KEY=
ELICE_BASE_URL=
ELICE_MODEL=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
LLM_REASONING_EFFORT=

# 우선순위: 함수에 주입한 LLMSettings > 에이전트별 값 > 위 공통 값 > 코드 기본값.
# 빈 에이전트별 값은 공통 값으로 돌아갑니다. reasoning_effort 미설정 시 전송하지 않습니다.
# JSON mode/토큰 한도/reasoning_effort/tool 호출 지원 여부는 실제 모델별로 연결시험이 필요합니다.
DECISION_LLM_MODEL=
DECISION_LLM_API_KEY=
DECISION_LLM_BASE_URL=
DECISION_LLM_MAX_TOKENS=
DECISION_LLM_TIMEOUT_SECONDS=
DECISION_LLM_REASONING_EFFORT=
INDUSTRY_MAPPING_LLM_MODEL=
INDUSTRY_MAPPING_LLM_API_KEY=
INDUSTRY_MAPPING_LLM_BASE_URL=
INDUSTRY_MAPPING_LLM_MAX_TOKENS=
INDUSTRY_MAPPING_LLM_TIMEOUT_SECONDS=
INDUSTRY_MAPPING_LLM_REASONING_EFFORT=

# ─── 주소 → 좌표 ───
# 카카오 REST 키. 단일 일치 주소 후보만 사용하며 대체 지오코딩은 하지 않습니다.
GEOCODING_API_KEY=

# ─── 분석 데이터 API (공공데이터포털) ───
FLOATING_POPULATION_API_KEY=
BUSINESS_LIFECYCLE_API_KEY=
COMMERCIAL_AREA_API_KEY=

# ─── 개폐업 분석 추가 설정 ───
# 테스트나 재현용으로 특정 분기를 강제할 때만 사용합니다.
# 비워 두면 서울시 API에서 해당 상권의 최신 유효 분기를 자동 탐색합니다.
BUSINESS_LIFECYCLE_BASE_QUARTER=
BUSINESS_LIFECYCLE_QUARTER_COUNT=12
# 저장소·wheel에 포함하지 않는 서울시 상권영역 SHP입니다. 배포 환경에서 파일 경로를 지정합니다.
BUSINESS_LIFECYCLE_AREA_SHP_PATH=

# 현재 MVP에서 특정 상권을 강제로 지정할 때 사용합니다.
# 둘 다 비어 있으면 자동 상권 판별을 시도합니다.
BUSINESS_LIFECYCLE_AREA_CODE=
BUSINESS_LIFECYCLE_AREA_NAME=

# ─── 상권 경쟁 분석 추가 설정 ───
FRANCHISE_API_KEY=
# 공공데이터 쿼터(하루 10,000건)와 429를 고려한 동시 요청 수
SBIZ_MAX_CONCURRENCY=4

# ─── 서버 ───
# 상대 경로는 backend 기준입니다.
SQLITE_PATH=storage/chaeum.sqlite3
# 유한한 양수(초). 개별 분석과 전체 실행의 제한시간입니다.
ANALYSIS_AGENT_TIMEOUT_SECONDS=180
ANALYSIS_TIMEOUT_SECONDS=600
# wait=false 백그라운드 동시 분석 수 (기본 2)
ANALYSIS_MAX_CONCURRENCY=2

# 프론트엔드 주소. 여러 개면 쉼표로 이어 붙입니다.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 1이면 외부 호출 없이 고정 응답을 돌려줍니다. 화면 연동용.
MOCK_MODE=

# 지도 선택 조회. REST 키는 GEOCODING_API_KEY를 재사용합니다.
MAP_ANALYSIS_MAX_CONCURRENCY=4
# 비워 두면 기존 공통 ELICE·LLM 설정을 사용합니다.
MAP_MAPPING_LLM_MODEL=
MAP_MAPPING_LLM_API_KEY=
MAP_MAPPING_LLM_BASE_URL=
MAP_MAPPING_LLM_MAX_TOKENS=
MAP_MAPPING_LLM_TIMEOUT_SECONDS=
MAP_MAPPING_LLM_REASONING_EFFORT=
# 분석 모드: single_decision(기본, 2.0) 또는 multi_agent(3.0). 바꾼 뒤 서버를 재시작합니다.
ANALYSIS_MODE=single_decision
# 전문가별 SPECIALIST_{에이전트명}_LLM_MODEL/API_KEY/BASE_URL 설정 가능.
# 비워 두면 기존 ELICE 공통 설정을 사용합니다.
SPECIALIST_FLOATING_POPULATION_LLM_MODEL=
SPECIALIST_BUSINESS_LIFECYCLE_LLM_MODEL=
SPECIALIST_COMMERCIAL_AREA_LLM_MODEL=
SPECIALIST_MAP_ANALYSIS_LLM_MODEL=

# 브리핑·평가자는 독립 설정입니다. 아래 두 줄은 사용할 때 주석을 풀고 true/false를 넣습니다.
# 빈 문자열·yes는 허용하지 않습니다. 브리핑 미설정 시 ANALYSIS_MODE를 따릅니다.
# BRIEFING_ENABLED=
# EVALUATORS_ENABLED=
# 평가자 사용 시 기본 전체 시간은 1200초입니다. 위 ANALYSIS_TIMEOUT_SECONDS 명시값이 우선합니다.
# 평가자별 설정이 비어 있으면 공통 ELICE·LLM 설정을 사용합니다.
EVALUATOR_LLM_MODEL=
EVALUATOR_LLM_API_KEY=
EVALUATOR_LLM_BASE_URL=
EVALUATOR_LLM_MAX_TOKENS=
EVALUATOR_LLM_TIMEOUT_SECONDS=
EVALUATOR_LLM_REASONING_EFFORT=
