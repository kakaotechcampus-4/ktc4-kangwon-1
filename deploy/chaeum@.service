# 채움 백엔드 systemd 유닛 (템플릿).
#
# 파일 이름의 @ 가 템플릿 표시입니다. %i 자리에 포트가 들어가서
# 파일 하나로 chaeum@8001, chaeum@8002 를 둘 다 띄울 수 있습니다.
# 무중단 배포는 이 둘을 번갈아 쓰면서 nginx 가 가리키는 쪽만 바꿉니다.
#
# 배포 스크립트가 /etc/systemd/system/chaeum@.service 로 설치합니다.

[Unit]
Description=채움 백엔드 (포트 %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# current 는 심볼릭 링크입니다. systemd 가 기동 시점에 실제 경로로 확정하므로,
# 나중에 링크를 다른 릴리스로 돌려도 이미 떠 있는 프로세스는 자기 릴리스를 계속 봅니다.
WorkingDirectory=/opt/chaeum/current/backend

# SQLITE_PATH 를 비우면 backend/ 기준 상대경로라 릴리스를 옮길 때 DB 도 따라갑니다.
# 공유 저장소를 절대경로로 못 박습니다.
Environment=SQLITE_PATH=/opt/chaeum/shared/storage/chaeum.sqlite3

# python -m 으로 실행해야 현재 디렉터리가 import 경로 맨 앞에 붙습니다.
# 그래야 구·신 프로세스가 각자 자기 릴리스의 코드를 씁니다.
# --workers 는 쓰지 않습니다. 분석 작업표가 프로세스 메모리에 있어 워커는 1개여야 합니다.
ExecStart=/opt/chaeum/shared/venv/bin/python -m uvicorn app.main:create_app \
          --factory --host 127.0.0.1 --port %i

Restart=on-failure
RestartSec=5
# 종료 시 진행 중 분석을 10초 동안 정리합니다. 여유를 둡니다.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
