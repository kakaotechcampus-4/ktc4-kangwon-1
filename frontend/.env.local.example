# 127.0.0.1 이 아니라 localhost 여야 프론트와 같은 사이트가 되어 세션 쿠키가 붙습니다.
# (포트는 사이트 판정에 들어가지 않습니다)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 실제 배포 주소로 교체 필요 — 팀원에게 확인

# true면 백엔드 없이 처음부터 끝까지 mock 데이터로 동작합니다(화면 흐름 확인용).
# 바꾼 뒤에는 개발 서버를 다시 띄워야 합니다.
NEXT_PUBLIC_MOCK_MODE=false

# Kakao Maps JavaScript key. Register http://localhost:3000 as a JavaScript SDK domain.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
